# ── Kalshi API credentials ────────────────────────────────────────────────────
# Generate at: https://kalshi.com/account/security → API Keys
# The key ID is shown in the UI; the private key is the .pem file you download.
KALSHI_API_KEY_ID=your_key_id_here
KALSHI_KEY_PATH=/path/to/your/kalshi_private_key.pem

# ── Finnhub economic calendar ─────────────────────────────────────────────────
# Free tier is enough. Get a key at: https://finnhub.io → Dashboard → API Keys
FINNHUB_KEY=your_finnhub_key_here

# ── Telegram alerts ───────────────────────────────────────────────────────────
# Setup:
#   1. Message @BotFather → /newbot → copy the token it gives you
#   2. Add the bot to your channel/group, or start a DM with it
#   3. Get the chat ID: send any message to the bot, then open:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      Copy the number in "chat" → "id" (negative for groups/channels)
#
# Leave blank to disable Telegram alerts (bot still runs, just silent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Notes ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The bot defaults to paper mode (no real orders placed).
# To enable live trading, pass --live when starting:
#   python -m src.main --live
#
# KALSHI_API_KEY_ID and KALSHI_KEY_PATH are only required in live mode.
