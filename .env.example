# Kalshi API credentials (RSA key pair — generate on Kalshi → Account → API Keys)
KALSHI_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=~/.kalshi_private_key.pem

# Kalshi data API key (can be same as KALSHI_KEY_ID, or a separate read-only key)
KALSHI_DATA_KEY_ID=your_data_key_id_here

# Kalshi API base URL (leave as-is for production; swap for demo URL during testing)
# KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_DATA_BASE=https://api.elections.kalshi.com/trade-api/v2

# Finnhub economic calendar API key (free tier)
FINNHUB_API_KEY=your_finnhub_key_here

# Discord webhook for alerts (optional — leave blank to disable)
DISCORD_WEBHOOK_URL=

# Bot mode: "paper" or "live"
BOT_MODE=paper
